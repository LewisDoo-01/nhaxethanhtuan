---
import Layout from "../../layouts/Layout.astro";
import FleetGrid from "../../components/FleetGrid.astro";
import QuoteForm from "../../components/QuoteForm.astro";

const title = "Thuê Xe Tự Lái - Thủ Tục Đơn Giản, Giao Xe Tận Nơi | Thanh Tuấn";
const description =
  "Thuê xe tự lái theo ngày hoặc theo tháng/dài hạn. Thủ tục đơn giản: CCCD + GPLX, giao xe tận nơi.";
---

<Layout title={title} description={description}>
  <section class="container mx-auto max-w-[1200px] px-6 py-12">
    <h1 class="mb-2 text-3xl font-extrabold text-secondary">
      Dịch Vụ Thuê Xe Tự Lái - Thủ Tục Đơn Giản, Giao Xe Tận Nơi
    </h1>
    <p class="mb-8 text-text-muted">
      Tự do lịch trình, chủ động thời gian. Áp dụng cho thuê theo ngày hoặc theo tháng/dài hạn.
    </p>

    <div class="mb-10 rounded-xl border border-border bg-bg-card p-6">
      <h2 class="mb-3 text-lg font-semibold">Thủ Tục Cần Chuẩn Bị</h2>
      <p class="mb-3 text-sm text-text-muted">
        Xem đầy đủ giấy tờ, tài sản thế chấp và phương thức thanh toán tại trang
        <a href="/thu-tuc-tu-lai" class="font-semibold text-primary hover:underline"
          >Thủ Tục Thuê Xe Tự Lái</a
        >.
      </p>
      <ul class="space-y-1 text-sm">
        <li><i class="fa-solid fa-id-card mr-2 text-primary"></i>CCCD gắn chip bản gốc (hoặc VNeID cấp độ 2)</li>
        <li><i class="fa-solid fa-id-card mr-2 text-primary"></i>Giấy phép lái xe hạng B1, B2 trở lên</li>
        <li><i class="fa-solid fa-vault mr-2 text-primary"></i>Tài sản thế chấp: xe máy chính chủ hoặc ký quỹ tiền mặt</li>
      </ul>
    </div>

    <h2 class="mb-4 text-xl font-bold">Đội Xe Cho Thuê Tự Lái</h2>
    <div class="mb-10">
      <FleetGrid />
    </div>

    <QuoteForm id="tu-lai-quote-form" heading="Nhận Báo Giá Chi Tiết" />
  </section>
</Layout>
