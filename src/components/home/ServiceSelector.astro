---
import PlaceholderImage from "../PlaceholderImage.astro";
---

<!-- IA §3.1.2 Lựa Chọn Dịch Vụ Nhanh -->
<section class="container mx-auto max-w-[1200px] px-6 py-12">
  <h2 class="mb-8 text-center text-2xl font-bold">Chọn Dịch Vụ Phù Hợp Với Bạn</h2>
  <div class="grid gap-6 sm:grid-cols-2">
    <a
      href="/dich-vu/co-tai-xe"
      class="group rounded-xl border border-border bg-bg-card p-6 transition hover:shadow-lg"
    >
      <PlaceholderImage label="tài xế lịch sự" class="mb-4" />
      <h3 class="mb-2 text-lg font-semibold text-secondary group-hover:text-primary">
        Thuê Xe Có Tài Xế
      </h3>
      <p class="text-sm text-text-muted">
        Đưa đón sân bay, đi tỉnh, du lịch, công tác — tài xế chuyên nghiệp, rành đường.
      </p>
    </a>

    <a
      href="/dich-vu/tu-lai"
      class="group rounded-xl border border-border bg-bg-card p-6 transition hover:shadow-lg"
    >
      <PlaceholderImage label="khách nhận chìa khóa xe" class="mb-4" />
      <h3 class="mb-2 text-lg font-semibold text-secondary group-hover:text-primary">
        Thuê Xe Tự Lái
      </h3>
      <p class="text-sm text-text-muted">
        Tự do lịch trình, thủ tục đơn giản, giao xe tận nơi.
      </p>
    </a>
  </div>
</section>
